{
  "name": "starbelt-quotations",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Star Belt - professional Arabic price quotations (بيان سعر) maker with offline PWA support",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "icons": "python3 scripts/generate-icons.py",
    "check:pdf": "node scripts/check-pdf.mjs"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "preact": "^10.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@preact/preset-vite": "^2.9.0",
    "@types/node": "^22.10.0",
    "@vitest/ui": "^3.0.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "puppeteer": "^23.11.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
