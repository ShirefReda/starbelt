# Private AGY Local Gateway configuration
# Copy to /etc/agy-gateway/env with permissions chmod 600 owned by the dedicated user.

# Required: shared bearer secret (minimum 32 random characters).
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(40))"
GATEWAY_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS_HERE

# Path or name of the official `agy` binary (default: agy)
AGY_BIN=agy

# Fixed, empty workspace directory owned by the dedicated service user
AGY_WORKSPACE=/srv/agy-workspace

# Default model ID from `agy models` (default: gemini-3.8-flash-medium)
# Options for Gemini 3.8 Flash: gemini-3.8-flash-low, gemini-3.8-flash-medium, gemini-3.8-flash-high
AGY_MODEL=gemini-3.8-flash-medium

# Minimum gap in seconds between consecutive `agy` runs (default: 2)
AGY_MIN_GAP=2

# Timeout in seconds for each `agy` call before killing its process group (default: 120)
AGY_TIMEOUT=120

# Localhost port to bind on 127.0.0.1 only (default: 8787)
PORT=8787

# Optional kill-switch path: if this file exists, every request returns 503
AGY_KILL_SWITCH_FILE=/srv/agy-gateway/DISABLED
